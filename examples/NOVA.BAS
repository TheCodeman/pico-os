10 REM NOVA STRIKE: a space shooter for Pico 2 mini OS BASIC.
20 REM SCREEN 13 graphics with the SPRITE extension, a MOD soundtrack (NOVA.MOD,
30 REM played with MUSIC), titles in the 16X16-F7 font sheet (FONT LOAD, GPRINT)
35 REM and sound effects queued with SOUND after PLAY "MB".
40 REM Keys: arrows or WASD move the ship while held, Space or Z fires, F turns
50 REM auto-fire on/off, B bomb, P pause, Esc quit. A mouse steers too.
60 REM Every fifth wave is a mothership. Pick up P (more guns), S (shield)
70 REM and B (bomb) capsules. The high score is kept in NOVA.HI.
100 CLEAR: RANDOMIZE TIMER: KEY OFF
110 NE=8: NX=8: NR=16: NS=20
115 REM sprites: 0-19 stars, 20-31 enemy shots, 32-39 the ship's shots,
116 REM 40-47 enemies, 48 capsule, 49 mothership, 50 the ship, 51 its shield
130 DIM EX(NE),EY(NE),EK(NE),EA(NE),EH(NE),EP(NE),EB(NE),EV(NE)
150 DIM XX(NX),XY(NX),XR(NX),XM(NX),XA(NX)
160 DIM RX(NR),RY(NR),RU(NR),RV(NR),RL(NR),RC(NR)
170 DIM SV(NS)
180 DIM GS(300),KW(11),KH(11),CV(20),FP(5),SI(70),BI(30)
190 DIM GC(7),SF(8,8),SD(8,8),SN(8),SL(8),SPR(8),SCO(3),EHP(3)
200 E$=CHR$(27)+"[": C0$=E$+"0m": SCREEN 13: CLS
210 PRINT E$;"?25l";
220 REM ---- sprite shapes: pixel art from DATA, drawn, kept with GET, then
225 REM given to SPRITE SHAPE: 0 ship, 1-3 enemies, 4-6 capsules, 7-9 enemies' second frames, 10 ship's second frame ----
230 READ CM$: FOR I=1 TO LEN(CM$): READ CV(I): NEXT
240 FOR K=1 TO 11: CLS 1: READ W,H: KW(K)=W: KH(K)=H
250 FOR Y=0 TO H-1: READ R$: FOR X=0 TO W-1: C=INSTR(CM$,MID$(R$,X+1,1))
260 IF C>1 THEN PSET (X,Y),CV(C)
270 NEXT X,Y
280 GET (0,0)-(W-1,H-1),GS: SPRITE SHAPE K-1,GS: IF K=1 THEN GET (0,0)-(W-1,H-1),SI
282 IF K=7 THEN GET (0,0)-(W-1,H-1),BI
284 NEXT K
285 CLS 1: LINE (0,1)-(0,4),14: PSET (0,0),15: GET (0,0)-(0,4),GS: SPRITE SHAPE 11,GS: REM shot
287 CLS 1: LINE (0,0)-(2,2),12,BF: PSET (1,1),15: GET (0,0)-(2,2),GS: SPRITE SHAPE 12,GS: REM enemy shot
289 CLS 1: CIRCLE (10,10),10,44: CIRCLE (10,10),9,77: GET (0,0)-(20,20),GS: SPRITE SHAPE 15,GS: REM shield
290 REM the mothership, drawn with lines; then again in white for when it is hit (shapes 13, 14)
295 FOR OC=0 TO 1
300 CLS 1: FOR Y=-9 TO 9: W=23*SQR(1-(Y/9.6)^2): C=20+INT((9-Y)/1.6): IF OC THEN C=31
310 LINE (24-W,11+Y)-(24+W,11+Y),C: NEXT
320 FOR Y=-7 TO 0: W=9*SQR(1-(Y/7.6)^2): C=76-Y*2: IF OC THEN C=15
325 LINE (24-W,4+Y)-(24+W,4+Y),C: NEXT
330 LINE (0,11)-(47,11),8: LINE (1,10)-(46,12),24,B
340 FOR X=5 TO 43 STEP 6: PSET (X,11),36+(X MOD 12)\6*4: NEXT
350 LINE (8,17)-(12,23),8,BF: LINE (35,17)-(39,23),8,BF: LINE (21,18)-(27,22),4,BF: LINE (23,19)-(25,21),14,BF
360 GET (0,0)-(47,23),GS: SPRITE SHAPE 13+OC,GS: NEXT OC
365 FOR I=0 TO 2: CLS 1: PSET (0,0),19+I*4: GET (0,0)-(0,0),GS: SPRITE SHAPE 16+I,GS: NEXT: CLS 1: REM stars
400 REM ---- sound effects: notes (Hz) and lengths (ticks) ----
410 FOR I=1 TO 8: READ SN(I),SPR(I): SL(I)=0: FOR J=1 TO SN(I): READ SF(I,J),SD(I,J): SL(I)=SL(I)+SD(I,J)/18.2: NEXT J,I
420 FOR I=1 TO 3: READ SCO(I),EHP(I): NEXT: FOR I=0 TO 5: READ FP(I): NEXT
430 PLAY "MB": SE=0: SP=0
440 REM ---- stars: three layers, as sprites that fall at their own speeds ----
450 FOR I=0 TO NS-1: SV(I)=.4+(I MOD 3)*.9+RND*.3: NEXT
460 REM ---- music: NOVA.MOD next to the program, or in /EXAMPLES ----
470 MS=0: ON ERROR GOTO 9900
480 EF=0: MUSIC "NOVA.MOD": IF EF=0 THEN MS=1 ELSE EF=0: MUSIC "/EXAMPLES/NOVA.MOD": IF EF=0 THEN MS=1
490 IF MS=0 THEN EF=0: MUSIC "/NET/examples/NOVA.MOD": IF EF=0 THEN MS=1
500 HI=5000: EF=0: OPEN "NOVA.HI" FOR INPUT AS #1: IF EF=0 THEN INPUT #1,HI: CLOSE #1
505 F$="16X16-F7.PNG": FS=1: GOSUB 8600: FX=FK: REM titles and banners
506 F$="16X16-FG.PNG": FS=3: GOSUB 8600: FZ=3*FK: REM the title screen's help
507 F$="16X16-FA.PNG": FS=2: GOSUB 8600: FY=2*FK: REM the status display
508 PD$="": RESTORE 10610: FOR I=1 TO 3: READ P$: IF PD$="" THEN EF=0: OPEN P$+"NOVAPLAN.PNG" FOR INPUT AS #1: IF EF=0 THEN CLOSE #1: PD$=P$
509 NEXT: IF PD$="" THEN PD$="-"
510 ON ERROR GOTO 0: IF MS THEN MUSIC VOL 85
512 SX$="ARROWS OR WASD: MOVE    MOUSE: STEER    SPACE, Z OR CLICK: FIRE    F: AUTO FIRE    B: BOMB    P: PAUSE    ESC: QUIT    CAPSULES:  P MORE GUNS   S SHIELD   B BOMB    "
514 IF MS THEN SX$=SX$+"MUSIC: NOVA.MOD" ELSE SX$=SX$+"NO NOVA.MOD: NO MUSIC"
1000 REM ==== title screen ====
1010 VIEW: IG=0: CLS: AU=0: FOR I=20 TO 51: SPRITE I OFF: NEXT: GOSUB 3100: IF MS THEN MUSIC POS 0
1020 FONT FX: GOSUB 5500: RESTORE 10530
1030 T$="NOVA": Z=4: X0=(320-GWIDTH(T$)*Z)\2+3: Y0=14: NG=1: GC(0)=1: GOSUB 8000
1040 X0=X0-3: Y0=Y0-3: NG=8: FOR I=0 TO 7: READ GC(I): NEXT: GOSUB 8000
1050 T$="STRIKE": Z=2: X0=(320-GWIDTH(T$)*Z)\2+2: Y0=88: NG=1: GC(0)=105: GOSUB 8000
1060 X0=X0-2: Y0=Y0-2: NG=8: FOR I=0 TO 7: READ GC(I): NEXT: GOSUB 8000
1090 LINE (40,120)-(150,120),9: LINE (60,122)-(130,122),1
1095 FONT FY: T$="HI "+RIGHT$("0000000"+MID$(STR$(HI),2),7): GPRINT 12,128,T$
1100 TB=0: TL=TIMER: TD=TL+20: FONT FZ: SXP=320: SW=GWIDTH(SX$)
1110 REM title loop: stars, a blinking prompt, the help scrolling along the bottom, wait for a key
1120 T=TIMER: FC=FC+1: F=(T-TL)*30: TL=T: IF F>3 THEN F=3
1130 GOSUB 3000: SPRITE UPDATE F
1140 IF T>TB THEN TB=T+.5: BL=1-BL: T$="PRESS SPACE": Z=1: X0=12: Y0=158: NG=1: GC(0)=6+BL*8: GOSUB 8000
1145 FONT FZ: LINE (0,184)-(319,199),0,BF: GPRINT SXP,184,SX$: SXP=SXP-2.5*F: IF SXP<-SW THEN SXP=320
1150 K$=INKEY$: IF K$=" " OR K$=CHR$(13) OR (MOUSEB AND 1) THEN 2000
1160 IF K$=CHR$(27) THEN 9800 ELSE IF T>TD THEN AU=1: GOTO 2000
1170 IF TIMER-T<.033 THEN 1170
1180 GOTO 1120
2000 REM ==== new game ====
2010 SC=0: LV=3: SH=2: WL=1: BM=3: WV=0: NL=10000: PX=152: PY=166: TX=PX: TY=PY: LMX=MOUSEX: LMY=MOUSEY: QT=0: MD=2: BE=0: BU=0: VX=0: VY=0: MM=0: KB=KEYDOWN(0): AF=AU
2020 FOR I=0 TO NE-1: EA(I)=0: NEXT: FOR I=20 TO 51: SPRITE I OFF: NEXT
2030 FOR I=1 TO NX: XA(I)=0: NEXT: FOR I=1 TO NR: RL(I)=0: NEXT: UA=0: OA=0: DE=0
2040 CLS: IG=1: VIEW SCREEN (0,16)-(319,183): GOSUB 3100: GOSUB 7100: IF MS THEN MUSIC POS 2
2050 GOSUB 7000: TL=TIMER: T=TL: INV=TL+2: FT=TL: FC=0
2060 GOSUB 4800
2100 REM ==== main loop ====
2110 T=TIMER: F=(T-TL)*30: TL=T: IF F>3 THEN F=3
2120 FC=FC+1
2130 GOSUB 3000: REM stars
2140 GOSUB 3200: REM explosions and debris
2150 GOSUB 3400: REM keys and the ship
2160 GOSUB 4300: REM the ship's shots hit things
2170 GOSUB 3800: REM enemies
2180 GOSUB 4200: REM things hit the ship
2190 IF OA THEN GOSUB 4400: REM the mothership
2200 IF UA THEN IF SPRITEON(48)=0 THEN UA=0
2210 GOSUB 4900: REM waves
2220 IF BE THEN GOSUB 5300: REM banner
2230 IF HD THEN GOSUB 7000
2232 SPRITE UPDATE F
2235 IF T>=FQ THEN FQ=T+1: LOCATE 30,71: PRINT E$;"90m";RIGHT$(STR$(FC-FL),3);" fps";C0$;: FL=FC
2240 IF DE THEN IF T>DE THEN 2600
2250 IF QT THEN 1000
2260 IF TIMER-T<.025 THEN 2260
2270 GOTO 2110
2600 REM ---- the ship is lost ----
2610 DE=0: LV=LV-1: HD=1
2620 IF LV<0 THEN 2700
2630 PX=152: PY=166: TX=PX: TY=PY: VX=0: VY=0: SH=2: IF WL>1 THEN WL=WL-1
2640 INV=T+2.5: GOTO 2110
2700 REM ---- game over ----
2710 LV=0: DE=T+999: GOSUB 7000: IF MS THEN MUSIC POS 9
2720 T$="GAME OVER": Z=2: GOSUB 5200
2730 IF SC>HI AND AU=0 THEN HI=SC: ON ERROR GOTO 9900: EF=0: OPEN "NOVA.HI" FOR OUTPUT AS #1: IF EF=0 THEN PRINT #1,HI: CLOSE #1
2740 ON ERROR GOTO 0: BE=T+6: GOSUB 7000
2750 T=TIMER: F=(T-TL)*30: TL=T: IF F>3 THEN F=3
2760 GOSUB 3000: GOSUB 3200: GOSUB 3800: IF OA THEN GOSUB 4400
2765 IF BE THEN GOSUB 5300
2767 SPRITE UPDATE F
2770 K$=INKEY$: IF BE=0 OR (T>BE-4 AND K$<>"") THEN 1000
2780 IF TIMER-T<.025 THEN 2780
2790 GOTO 2750
3000 REM ---- stars (sprites 0-19, under everything): one that has fallen off the
3010 REM bottom starts again at the top ----
3020 FOR I=0 TO NS-1: IF SPRITEON(I)=0 THEN SPRITE I,INT(RND*320),0,16+I MOD 3,0,SV(I)
3030 NEXT: RETURN
3100 FOR I=0 TO NS-1: SPRITE I,INT(RND*320),INT(RND*200),16+I MOD 3,0,SV(I): NEXT: RETURN
3200 REM ---- explosions (two rings) and debris ----
3210 FOR I=1 TO NX: IF XA(I)=0 THEN 3260
3220 CIRCLE (XX(I),XY(I)),XR(I),0: CIRCLE (XX(I),XY(I)),XR(I)*.55,0
3230 IF XR(I)<3 THEN LINE (XX(I)-3,XY(I)-3)-(XX(I)+3,XY(I)+3),0,BF
3240 XR(I)=XR(I)+1.5*F: IF XR(I)>XM(I) THEN XA(I)=0: GOTO 3260
3250 C=FP(INT(XR(I)*5/XM(I))): CIRCLE (XX(I),XY(I)),XR(I),C: CIRCLE (XX(I),XY(I)),XR(I)*.55,FP(INT(XR(I)*3/XM(I)))
3260 NEXT I
3270 FOR I=1 TO NR: IF RL(I)<=0 THEN 3300
3280 PSET (RX(I),RY(I)),0: RX(I)=RX(I)+RU(I)*F: RY(I)=RY(I)+RV(I)*F: RV(I)=RV(I)+.06*F: RL(I)=RL(I)-F
3290 IF RL(I)>0 THEN IF RX(I)>=0 AND RX(I)<320 AND RY(I)>=0 AND RY(I)<200 THEN PSET (RX(I),RY(I)),RC(I)+(RL(I)<8)*-4 ELSE RL(I)=0
3300 NEXT I: RETURN
3400 REM ---- keys (and mouse), then move and draw the ship. With a USB keyboard
3401 REM (KEYDOWN) the ship moves while arrows/WASD are held; on the serial
3402 REM console a press sets it going flat out until the other way or Up/Down.
3405 IF AU THEN MM=1: GOSUB 6500
3410 K$=INKEY$: IF K$="" THEN 3500
3420 IF AU THEN QT=1: GOTO 3410 ELSE IF LEN(K$)=2 THEN K=ASC(RIGHT$(K$,1)) ELSE K=ASC(UCASE$(K$))
3430 IF KB THEN 3445 ELSE IF K=75 OR K=65 THEN MM=0: VX=-7 ELSE IF K=77 OR K=68 THEN MM=0: VX=7
3440 IF K=72 OR K=87 OR K=80 AND LEN(K$)=2 OR K=83 THEN MM=0: VX=0
3445 IF K=70 THEN AF=1-AF: GOSUB 7110 ELSE IF (K=32 OR K=90) AND KB=0 THEN BU=T+.4
3450 IF K=66 THEN GOSUB 5000: GOTO 3410
3460 IF K=80 AND LEN(K$)=1 THEN GOSUB 5100
3470 IF K=27 THEN QT=1
3490 GOTO 3410
3500 IF AU THEN 3522 ELSE MX=MOUSEX: MY=MOUSEY: IF MX<>LMX OR MY<>LMY THEN LMX=MX: LMY=MY: TX=MX-7: TY=MY-7: MM=1
3510 MB=MOUSEB: IF MB AND 1 THEN BU=T+.1
3515 IF (MB AND 2)<>0 AND (MD AND 2)=0 THEN GOSUB 5000
3517 MD=MB
3518 IF KB=0 OR AU THEN 3522
3519 VX=7*((KEYDOWN(75) OR KEYDOWN(30))-(KEYDOWN(77) OR KEYDOWN(32))): VY=5*((KEYDOWN(72) OR KEYDOWN(17))-(KEYDOWN(80) OR KEYDOWN(31))): IF VX OR VY THEN MM=0
3521 IF KEYDOWN(57) OR KEYDOWN(44) THEN BU=T+.05
3522 IF TX<0 THEN TX=0 ELSE IF TX>305 THEN TX=305
3530 IF TY<110 THEN TY=110 ELSE IF TY>167 THEN TY=167
3540 IF DE THEN RETURN
3545 IF MM THEN 3570
3564 PX=PX+VX*F: PY=PY+VY*F: IF PY<110 THEN PY=110 ELSE IF PY>167 THEN PY=167
3566 IF PX<0 THEN PX=0: VX=0 ELSE IF PX>305 THEN PX=305: VX=0
3569 TX=PX: TY=PY: GOTO 3590
3570 D=TX-PX: S=7*F: IF D>S THEN D=S ELSE IF D<-S THEN D=-S
3575 PX=PX+D: D=TY-PY: IF D>S THEN D=S ELSE IF D<-S THEN D=-S
3580 PY=PY+D
3590 IF T<INV AND (FC AND 2) THEN SPRITE 50 OFF ELSE SPRITE 50,PX,PY,10*(FC AND 1)
3610 IF SH>0 AND T<SHT THEN SPRITE 51,PX-3,PY-2,15 ELSE SPRITE 51 OFF
3620 IF T>=FT THEN IF AF OR T<BU THEN FT=T+.15: GOSUB 3700
3630 RETURN
3700 REM fire: one, two or three guns
3710 B=PX+7: D=0: GOSUB 3760
3720 IF WL>=2 THEN B=PX+2: D=0: GOSUB 3760: B=PX+12: GOSUB 3760
3730 IF WL>=3 THEN B=PX+4: D=-1.4: GOSUB 3760: B=PX+10: D=1.4: GOSUB 3760
3740 N=1: GOSUB 6000: RETURN
3760 FOR J=32 TO 39: IF SPRITEON(J)=0 THEN SPRITE J,B,PY-5,11,D,-7: RETURN
3770 NEXT: RETURN
3800 REM ---- enemies: move, draw, shoot, collide ----
3805 NA=0: AN=6*((FC\6) AND 1)
3810 FOR I=0 TO NE-1: IF EA(I)=0 THEN 3990
3820 K=EK(I): W=KW(K+1): H=KH(K+1)
3840 ON K GOSUB 3900,3920,3940
3850 IF EX(I)<-W OR EX(I)>320 OR EY(I)>200 THEN EA(I)=0: SPRITE 40+I OFF: GOTO 3990
3860 SPRITE 40+I,EX(I),EY(I),K+AN: NA=NA+1
3870 IF RND<FR*F THEN IF EY(I)<PY-30 THEN B=EX(I)+W/2: D=EY(I)+H: GOSUB 4100
3900 EY(I)=EY(I)+EV(I)*F*(1-2*(EY(I)<16)): EX(I)=EB(I)+28*SIN(T*1.7+EP(I)): RETURN
3920 EX(I)=EX(I)+EV(I)*F: EB(I)=EB(I)+.25*F: EY(I)=EB(I)+12*SIN(T*2.2+EP(I)): RETURN
3940 EY(I)=EY(I)+EV(I)*F*(1-(EY(I)<16)): D=PX+2-EX(I): IF ABS(D)>1 THEN EX(I)=EX(I)+SGN(D)*1.1*F
3950 RETURN
3990 NEXT I: RETURN
4000 REM ---- an enemy is destroyed (I): explosion, score, maybe a capsule ----
4050 K=EK(I): W=KW(K+1): H=KH(K+1): SPRITE 40+I OFF: EA(I)=0
4060 B=EX(I)+W/2: D=EY(I)+H/2: Z=14: GOSUB 5700: N=2: GOSUB 6000
4070 SC=SC+SCO(K): HD=1: IF SC>=NL THEN NL=NL+10000: LV=LV+1: N=5: GOSUB 6000
4080 IF UA=0 AND RND<.12 THEN UA=1: UK=INT(RND*3): SPRITE 48,B-4,D,4+UK,0,.9
4090 RETURN
4100 REM an enemy shot from (B,D), aimed at the ship
4110 FOR J=20 TO 31: IF SPRITEON(J)=0 THEN 4130
4120 NEXT: RETURN
4130 U=PX+7-B: V=PY+7-D: L=SQR(U*U+V*V)+.01: SPRITE J,B-1,D,12,U/L*QS,V/L*QS: RETURN
4200 REM ---- things that hit the ship: shots, enemies, the mothership; and capsules ----
4210 IF DE THEN RETURN
4220 IF UA THEN IF SPRITEHIT(50,48,48)>=0 THEN GOSUB 4760
4230 IF T<INV THEN RETURN
4240 H=SPRITEHIT(50,20,31): IF H>=0 THEN SPRITE H OFF: GOSUB 5600: RETURN
4250 H=SPRITEHIT(50,40,47): IF H>=0 THEN I=H-40: GOSUB 4050: GOSUB 5600: RETURN
4260 IF OA THEN IF SPRITEHIT(50,49,49)>=0 THEN GOSUB 5600
4270 RETURN
4300 REM ---- the ship's shots (they move by themselves): what did they hit? ----
4305 IF NA=0 AND OA=0 THEN RETURN
4310 FOR J=32 TO 39: H=-1: IF SPRITEON(J) THEN H=SPRITEHIT(J,40,47): IF H<0 AND OA<>0 THEN H=SPRITEHIT(J,49,49)
4315 IF H>=0 THEN SPRITE J OFF: GOSUB 4350
4320 NEXT J: RETURN
4350 IF H=49 THEN IF OD=0 THEN OH=OH-1: GOSUB 5450: N=7: GOSUB 6000: RETURN ELSE RETURN
4360 I=H-40: EH(I)=EH(I)-1: IF EH(I)<=0 THEN GOSUB 4050: RETURN
4370 N=7: GOSUB 6000: RETURN
4400 REM ---- the mothership ----
4420 IF OY<24 THEN OY=OY+.4*F ELSE OX=136+118*SIN((T-OT)*.6)
4430 IF OD THEN 4600
4440 IF OHF THEN OHF=0: SPRITE 49,OX,OY,14 ELSE SPRITE 49,OX,OY,13
4445 IF FC MOD 3=0 THEN GOSUB 5480
4450 IF T>OF AND OY>=24 THEN OF=T+1.1-WV*.02: GOSUB 4500
4470 RETURN
4500 REM mothership fire: aimed triple, or a fan
4510 OP=1-OP: B=OX+24: D=OY+24
4520 IF OP THEN GOSUB 4100: B=OX+10: GOSUB 4100: B=OX+37: GOSUB 4100: N=7: GOSUB 6000: RETURN
4530 FOR A=-2 TO 2: FOR J=20 TO 31: IF SPRITEON(J)=0 THEN SPRITE J,B,D,12,SIN(A*.38)*QS,COS(A*.38)*QS: EXIT FOR
4540 NEXT J,A: N=7: GOSUB 6000: RETURN
4600 REM the mothership breaks up
4610 IF T>OE THEN OA=0: SPRITE 49 OFF: SC=SC+5000: HD=1: B=OX+24: D=OY+12: Z=40: GOSUB 5700: N=6: GOSUB 6000: IF MS THEN MUSIC POS 3
4620 IF OA=0 THEN LINE (100,17)-(219,20),0,BF: T$="BONUS 5000": Z=2: GOSUB 5200: WN=-1: WT=T+3: RETURN
4630 SPRITE 49,OX,OY,13: IF T>OQ THEN OQ=T+.12: B=OX+4+RND*40: D=OY+RND*22: Z=12+RND*8: GOSUB 5700: N=2: GOSUB 6000
4640 RETURN
4700 REM ---- a capsule is collected ----
4760 UA=0: SPRITE 48 OFF: N=3: GOSUB 6000: HD=1
4770 IF UK=0 THEN IF WL<3 THEN WL=WL+1 ELSE SC=SC+500
4780 IF UK=1 THEN IF SH<3 THEN SH=SH+1 ELSE SC=SC+500
4790 IF UK=2 THEN IF BM<5 THEN BM=BM+1 ELSE SC=SC+500
4795 RETURN
4800 REM ---- next wave: how many, how fast, what kinds ----
4810 WV=WV+1: HD=1: SQ=0: QS=2.2+WV*.08: IF QS>3.6 THEN QS=3.6
4820 FR=.0035+WV*.0012: IF FR>.016 THEN FR=.016
4830 SPD=1+WV*.07: IF SPD>2 THEN SPD=2
4840 IF WV MOD 5=0 THEN T$="WARNING": Z=2: GOSUB 5200: WN=0: WT=T+3: OB=1: N=8: GOSUB 6000: RETURN
4850 WN=8+WV*2: IF WN>26 THEN WN=26
4860 WI=.95-WV*.05: IF WI<.35 THEN WI=.35
4870 T$="WAVE"+STR$(WV): Z=2: GOSUB 5200: WT=T+2.6: RETURN
4900 REM ---- spawning, and the end of a wave ----
4910 IF OB THEN IF T>WT THEN OB=0: OA=1: HD=1: OD=0: OX=136: OY=0: OT=T: OH=30+WV*6: OM=OH: OF=T+2: IF MS THEN MUSIC POS 7
4915 IF OB THEN RETURN
4920 IF OA THEN RETURN
4930 IF WN>0 THEN IF T>WT THEN GOSUB 4960: RETURN
4940 IF WN=0 THEN A=0: FOR I=0 TO NE-1: A=A+EA(I): NEXT: IF A=0 THEN WN=-1: WT=T+1.2
4950 IF WN<0 THEN IF T>WT THEN GOSUB 4800
4955 RETURN
4960 FOR I=0 TO NE-1: IF EA(I)=0 THEN 4970
4965 NEXT: WT=T+.2: RETURN
4970 K=1: R=RND: IF SQ>0 THEN 4980
4972 IF WV>=2 AND R<.3 THEN K=2
4975 IF WV>=3 AND R>.78 THEN K=3
4980 EA(I)=1: EK(I)=K: EH(I)=EHP(K)+WV\6: EP(I)=RND*6.3: WN=WN-1: WT=T+WI*(.6+RND*.8)
4985 ON K GOTO 4990,4993,4996
4990 QF=0: IF SQ>0 THEN SQ=SQ-1: SP2=SP2-.5: EB(I)=SB: EP(I)=SP2: QF=1: IF SQ>0 THEN WT=T+.3
4991 IF QF=0 THEN EB(I)=34+RND*240: IF WN>=2 THEN SQ=2: SB=EB(I): SP2=EP(I): WT=T+.3
4992 EX(I)=EB(I)+28*SIN(T*1.7+EP(I)): EY(I)=-KH(2): EV(I)=.8*SPD: RETURN
4993 EB(I)=24+RND*50: EY(I)=EB(I): IF RND<.5 THEN EX(I)=-KW(3): EV(I)=1.6*SPD ELSE EX(I)=320: EV(I)=-1.6*SPD
4994 RETURN
4996 EX(I)=10+RND*290: EY(I)=-KH(4): EV(I)=1.7*SPD: RETURN
5000 REM ---- bomb: a white flash, then every enemy goes ----
5010 IF BM=0 OR DE THEN RETURN
5020 BM=BM-1: HD=1: N=6: GOSUB 6000
5030 LINE (0,0)-(319,199),15,BF: PAUSE 40: CLS 1
5040 FOR I=0 TO NE-1: IF EA(I) THEN GOSUB 4050
5050 NEXT: FOR J=20 TO 31: SPRITE J OFF: NEXT
5060 IF OA THEN IF OD=0 THEN OH=OH-12: GOSUB 5450
5070 IF BE THEN BR=0
5080 RETURN
5100 REM ---- pause ----
5110 IF MS THEN MUSIC PAUSE
5120 FONT FX: T$="PAUSED": Z=2: X0=(320-GWIDTH(T$)*Z)\2: Y0=84: NG=1: GC(0)=14: GOSUB 8000
5130 IF INKEY$="" THEN 5130
5140 IF MS THEN MUSIC RESUME
5150 LINE (0,84)-(319,84+FONTH(FX)*2),0,BF: TL=TIMER: T=TL: RETURN
5200 REM ---- banner T$ (scale Z) in the middle of the playfield for 2.5 s ----
5210 IF BE THEN GOSUB 5400
5220 Y0=76: BE=T+2.5: BR=0: BT$=T$: BZ=Z
