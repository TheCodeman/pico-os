10 REM COINS.BAS: spinning coins bouncing over a sky, drawn in the sprite
20 REM editor (`sprite COIN.SPR`): SPRITE LOAD makes its 8 frames shapes 0-7
30 SCREEN 13: CLS
40 F$="COIN.SPR": ON ERROR GOTO 900
50 SPRITE LOAD F$, 0
60 ON ERROR GOTO 0
70 FOR Y=0 TO 179: LINE (0,Y)-(319,Y),RGB(40,60+Y/2,140+Y/2): NEXT
80 LINE (0,180)-(319,199),RGB(60,140,40),BF
90 LOCATE 1,1: PRINT "COINS: any key quits"
100 N=16: DIM X(N),Y(N),DX(N),DY(N),F(N)
110 FOR I=1 TO N: X(I)=RND*300: Y(I)=20+RND*140: DX(I)=RND*3-1.5: DY(I)=RND*3-1.5: F(I)=RND*8: NEXT
120 FOR I=1 TO N
130 X(I)=X(I)+DX(I): Y(I)=Y(I)+DY(I)
140 IF X(I)<0 OR X(I)>304 THEN DX(I)=-DX(I)
150 IF Y(I)<16 OR Y(I)>164 THEN DY(I)=-DY(I)
160 F(I)=F(I)+.4: IF F(I)>=8 THEN F(I)=F(I)-8
170 SPRITE I, X(I), Y(I), INT(F(I))
180 NEXT
190 SPRITE UPDATE: PAUSE 30
200 IF INKEY$="" THEN 120
210 SCREEN 0: END
900 IF F$="COIN.SPR" THEN F$="/EXAMPLES/COIN.SPR": RESUME 50
910 SCREEN 0: PRINT "COINS needs COIN.SPR next to it or in /EXAMPLES": END
