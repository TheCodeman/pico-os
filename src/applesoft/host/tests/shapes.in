HIMEM: 49152
10 DATA 2,0,6,0,16,0,45,54,63,36,45,0,73,18,46,4,0
20 FOR I = 0 TO 16: READ B: POKE 768+I,B: NEXT
30 POKE 232,0: POKE 233,3
40 HGR: HCOLOR=3
50 FOR R = 0 TO 63 STEP 4: ROT=R: SCALE = 1 + R/8: DRAW 1 AT 20 + R*4, 40: NEXT
60 SCALE=3: ROT=0: DRAW 2 AT 100,100: PRINT PEEK(234)
70 XDRAW 2 AT 100,100: PRINT PEEK(234)
80 HCOLOR=5: DRAW 1: DRAW 2: XDRAW 1 AT 278,190: XDRAW 1 AT 2,1
90 SCALE=0: ROT=16: DRAW 1 AT 140,96
100 HPLOT TO 10,10
RUN
DRAW 3
