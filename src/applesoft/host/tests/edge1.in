HIMEM: 49152
10 A$ = "ABCDEF"
20 PRINT LEFT$(A$,1) + LEFT$(A$,2) + LEFT$(A$,3) + MID$(A$,2,2)
30 PRINT ("A"+"B")+("C"+("D"+"E"))
40 PRINT VAL("1E");VAL(".");VAL("-");VAL("1..2");VAL("+5");VAL("1E+2");VAL(" 1 2 3");VAL("&")
50 B$ = "": FOR I = 1 TO 255: B$ = B$ + "X": NEXT: PRINT LEN(B$): PRINT FRE(0)
60 FOR I = 1 TO 50: C$ = STR$(I): NEXT: PRINT FRE(0);C$
70 PRINT "LINE1";CHR$(13);"LINE2";CHR$(10);"X"
80 PRINT 1;-1;-.5;1E10;-1E-10
90 FOR I = 1 TO 3: FOR J = 1 TO 3: IF J = 2 THEN NEXT I
100 PRINT I;J
110 FOR K = 1 TO 10: K = K + 3: PRINT K;: NEXT: PRINT
120 X% = 32767.4: PRINT X%: X% = -32767.6: PRINT X%
130 TRACE: A = 1: B = 2: NOTRACE: PRINT "T"
140 DEF FN A(X) = X+1: PRINT FN A(1): DEF FN A(X) = X+2: PRINT FN A(1)
150 GOSUB 500: PRINT "BACK FROM 500"
160 PRINT "POS";: PRINT TAB(20);POS(0)
170 HTAB 0: PRINT "H0";: HTAB 41: PRINT "H41": HTAB 80: PRINT "H80"
180 PRINT "END OF EDGE": END
500 ONERR GOTO 520
510 X = 1/0
520 CALL -3288: POKE 216,0: PRINT "CAUGHT";PEEK(222): RETURN
RUN
B$="": FOR I = 1 TO 256: B$ = B$ + "X": NEXT
PRINT ((("A"+"B")+("C"+"D"))+(("E"+"F")+("G"+"H")))
X% = 32767.5
