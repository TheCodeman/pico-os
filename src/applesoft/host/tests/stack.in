HIMEM: 49152
10 N = N + 1: GOSUB 10
RUN
PRINT N
10 FOR A=1TO2:FOR B=1TO2:FOR C=1TO2:FOR D=1TO2:FOR E=1TO2:FOR F=1TO2:FOR G=1TO2:FOR H=1TO2:FOR I=1TO2:FOR J=1TO2:FOR K=1TO2
20 PRINT "DEEP"
RUN
10 FOR A=1TO2:FOR B=1TO2:FOR C=1TO2:FOR D=1TO2:FOR E=1TO2:FOR F=1TO2:FOR G=1TO2:FOR H=1TO2:FOR I=1TO2:FOR J=1TO2
20 PRINT "TEN";: END
RUN
PRINT ((((((((((((((((((((1))))))))))))))))))))
PRINT (((((((((((((((((((((((((((((((((((((((1)))))))))))))))))))))))))))))))))))))))
10 FOR I = 1 TO 3: FOR I = 1 TO 2: PRINT I;: NEXT: NEXT
RUN
10 GOSUB 20: PRINT "R": END
20 FOR I = 1 TO 5: RETURN
RUN
