HIMEM: 49152

]10 FOR X = -3 TO 3 STEP .7

]20 PRINT X;": ";INT(X);" ";ABS(X);" ";SGN(X);" ";SIN(X);" ";COS(X)

]30 NEXT

]40 FOR X = .1 TO 10 STEP 1.3: PRINT LOG(X);" ";EXP(X);" ";ATN(X);" ";TAN(X): NEXT

]50 PRINT 2^10;2^-2;(-2)^3;-2^2;(-8)^(1/3)

]60 PRINT 2+3*4;(2+3)*4;2^3^2;10-3-2;100/10/2;-3^2

]70 PRINT 1<2;2<1;1=1;1<>1;1><2;2>=2;2=>3;1<=0;"A"<"B";"AB">"A";"A"="A"

]80 PRINT 1 AND 0;1 AND 2;0 OR 0;0 OR 5;NOT 0;NOT 7;NOT 1+1;-1 AND -1

]90 PRINT RND(-1);RND(1);RND(1);RND(0);RND(1);RND(-5);RND(1);RND(1)

]100 X = RND(-1): FOR I = 1 TO 10: PRINT INT(RND(1)*100);" ";: NEXT: PRINT

]110 PRINT EXP(1);LOG(EXP(1));ATN(1)*4;SIN(3.14159265);COS(0)

]120 A% = 2.7: B% = -2.7: C% = 32767: PRINT A%;B%;C%;-A%;A%/B%

]130 D% = -32767: PRINT D%: E% = 1E4*3: PRINT E%

]140 PRINT 7/0

]RUN
