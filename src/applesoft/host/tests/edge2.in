HIMEM: 49152
10 ONERR GOTO 100
20 GOSUB 50
30 PRINT "NEVER HERE"
40 END
50 X = SQR(-1)
60 RETURN
100 PRINT "ERR";PEEK(222): POKE 216,0: RETURN
RUN
10 FOR I = 1 TO 3
20 PRINT I: IF I = 2 THEN STOP
30 NEXT
RUN
CONT
PRINT I
10 PRINT "A";
20 GOTO 10
15 END
RUN
10 X = 5: END: PRINT "AFTER END"
20 PRINT "LINE 20"
RUN
CONT
GOTO 20
RUN 20
