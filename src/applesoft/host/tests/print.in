HIMEM: 49152
10 FOR I = -12 TO 12: PRINT 10^I;" ";-3.14159265*10^I;" ";1/3*10^I: NEXT
20 PRINT 0;-0;1;-1;.5;-.5;123456789;1234567890;999999999;.01;.001;.0099999
30 PRINT 1E38;1.7E38;-1E-38;2.9E-39;1E-39
40 PRINT "A","B","C","D","E"
50 PRINT "12345678901234567890123456789","X"
60 PRINT TAB(5);"T5";TAB(20);"T20";TAB(3);"T3"
70 PRINT SPC(3);"S3";SPC(0);"S0"
80 PRINT "POS";POS(0);: PRINT POS(0)
90 PRINT 1;2;3: PRINT "A";: PRINT "B"
100 PRINT 1,2,3,4,5,6
110 PRINT 1/3+1/3+1/3;1-1/3*3;.1+.2;.3-.1;100*1.1;3*.1
120 PRINT 255/256;65535*65536;2^31;2^31-1;2^32;-2^24
130 ? "QUESTION";
140 PRINT
150 PRINT SQR(2);SQR(4);SQR(16);SQR(.25);2^.5;4^.5
RUN
