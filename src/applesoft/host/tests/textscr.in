HIMEM: 49152
10 HOME: PRINT "NORMAL";: INVERSE: PRINT "INVERSE";: FLASH: PRINT "FLASH 123";: NORMAL: PRINT "BACK"
20 HTAB 30: PRINT "H30";: VTAB 10: PRINT "V10": HTAB 45: PRINT "H45"
30 POKE 32,5: POKE 33,20: POKE 34,12: POKE 35,18: HOME
40 FOR I = 1 TO 12: PRINT "WINDOW LINE ";I;" MORE TEXT HERE": NEXT
50 TEXT: VTAB 20: PRINT "lower case";CHR$(7);"BELL"
60 PRINT PEEK(36);PEEK(37);PEEK(40);PEEK(41)
70 VTAB 22: HTAB 3: CALL -868: VTAB 1: HTAB 39: PRINT "XY";
80 VTAB 23: INVERSE: PRINT "    ": NORMAL: CALL -958
90 POKE 1024+39,193: PRINT PEEK(1024)
RUN
