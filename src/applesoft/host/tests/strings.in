HIMEM: 49152
10 A$ = "HELLO WORLD": B$ = "abc"
20 PRINT LEFT$(A$,5);"|";RIGHT$(A$,5);"|";MID$(A$,7);"|";MID$(A$,3,4);"|";LEN(A$)
30 PRINT ASC(A$);ASC(B$);CHR$(65);CHR$(97);STR$(3.14);STR$(-1E20);VAL("12.5E2");VAL("  -7 ");VAL("ABC");VAL("3X")
40 PRINT LEFT$(A$,100);"|";RIGHT$(A$,100);"|";MID$(A$,20);"|";MID$(A$,1,0);"|"
50 C$ = A$ + " " + B$: PRINT C$;LEN(C$)
60 PRINT "A" < "AB";"B" > "AB";"ABC" = "ABC";"" < "A";A$ <> B$
70 D$ = "": FOR I = 1 TO 10: D$ = D$ + CHR$(64+I): NEXT: PRINT D$
80 PRINT FRE(0)
90 X$ = "": FOR I = 1 TO 300: X$ = X$ + "*": NEXT
RUN
PRINT LEFT$("ABC",0)
PRINT MID$("ABC",0)
PRINT ASC("")
PRINT CHR$(256)
PRINT "A" + 1
PRINT FRE(0)
A$="X":B$=A$:PRINT FRE(0)
