?STRING TOO LONG ERROR IN 90
]PRINT LEFT$("ABC",0)

?ILLEGAL QUANTITY ERROR
]PRINT MID$("ABC",0)

?ILLEGAL QUANTITY ERROR
]PRINT ASC("")

?ILLEGAL QUANTITY ERROR
]PRINT CHR$(256)

?ILLEGAL QUANTITY ERROR
]PRINT "A" + 1

?TYPE MISMATCH ERROR
]PRINT FRE(0)
