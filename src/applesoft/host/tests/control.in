HIMEM: 49152
10 FOR I = 1 TO 3: FOR J = 1 TO 2: PRINT I;J;" ";: NEXT J, I: PRINT
20 FOR I = 10 TO 1 STEP -3: PRINT I;: NEXT: PRINT
30 FOR I = 1 TO 0: PRINT "ONCE";I: NEXT: PRINT I
40 FOR X = 1 TO 2 STEP 0.5: PRINT X;: NEXT: PRINT
50 GOSUB 200: PRINT "BACK"
60 ON 2 GOTO 70, 80, 90
70 PRINT "SEVENTY"
80 PRINT "EIGHTY": ON 3 GOSUB 200, 210, 220: PRINT "AFTER ON"
85 ON 0 GOTO 70: ON 9 GOSUB 200: PRINT "NONE TAKEN"
90 IF 1 THEN PRINT "TRUE1": IF 0 THEN PRINT "NEVER"
95 PRINT "AFTER IF"
100 IF 1 > 0 THEN 120
110 PRINT "SKIPPED"
120 IF "A" THEN PRINT "STRING IF"
130 IF 2 GOTO 140
135 PRINT "NO"
140 GOSUB 300: PRINT "POPPED"
150 FOR I = 1 TO 3: GOSUB 400: NEXT
160 END
200 PRINT "SUB200": RETURN
210 PRINT "SUB210": RETURN
220 PRINT "SUB220": RETURN
300 POP: GOTO 145
400 PRINT "L";I;: RETURN
145 PRINT "POPPED2": GOTO 150
RUN
GOTO 999
RETURN
NEXT
POP
CONT
