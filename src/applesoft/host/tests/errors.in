HIMEM: 49152
10 ONERR GOTO 100
20 PRINT "START"
30 X = 1/0
40 PRINT "AFTER": GOTO 60
50 PRINT "NEVER"
60 A$ = "": B = ASC(A$)
70 PRINT "END": END
100 PRINT "ERR";PEEK(222);" LINE";PEEK(218)+256*PEEK(219)
110 IF PEEK(222) = 133 AND C < 2 THEN C = C + 1: RESUME
120 GOTO 70
RUN
10 X = 1/0
RUN
PRINT 1/0
10 PRINT "A": STOP: PRINT "B"
RUN
CONT
10 PRINT ")
RUN
10 READ A
RUN
10 FOR I=1 TO 2:NEXT J
RUN
10 X=1:X(1,2)=1:DIM X(5)
RUN
